<odoo>
    <record id="privilege_hr_timesheet_portal" model="res.groups.privilege">
        <field name="name">Editable timesheets</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_hr_timesheet_portal" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_hr_timesheet_portal"/>
        <field name="comment">Allows users to edit timesheets through portal</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_hr_timesheet_portal'))]"/>
    </record>

    </odoo>
